#!/bin/sh

set -eu

: ${XDG_CACHE_HOME:=$HOME/.cache}
readonly state_file="$XDG_CACHE_HOME/colorscheme"

signal-kitty() {
    # This needs the following line in kitty.conf:
    # listen_on unix:/tmp/kitty.sock
    find /tmp -maxdepth 1 -name "kitty.sock*" | while read -r sock; do
        kitty @ --to "unix:$sock" "$@"
    done
}

set_wm() {
    ln -frs "$HOME/.config/sway/solarized-$1" "$HOME/.config/sway/solarized"
    : ${SWAYSOCK:=$(find /run/user/$(id -u) -maxdepth 1 -name "sway-ipc*")}
    export SWAYSOCK
    if [ -n "$SWAYSOCK" ] && command -v swaymsg >/dev/null 2>&1; then
        swaymsg --quiet reload >/dev/null 2>&1
    fi
}

set_system_theme() {
    case "$1" in
        light) local gtk_theme=Adwaita ;;
        dark) local gtk_theme=Adwaita-dark ;;
    esac
    gsettings set org.gnome.desktop.interface gtk-theme $gtk_theme
    gsettings set org.gnome.desktop.interface color-scheme prefer-$1
}

set_terminal() {
    ln -frs "$HOME/.dircolors.ansi-$1" ~/.dircolors
    ln -frs "$HOME/.config/kitty/solarized-$1.conf" "$HOME/.config/kitty/solarized.conf"
    signal-kitty  set-colors -a -c ~/.config/kitty/solarized.conf
}

set_x11() {
    ln -frs "$HOME/.Xresources.d/solarized-$1" "$HOME/.Xresources.d/solarized"
    xrdb -merge $HOME/.Xresources
}

}

set_theme() {
    mode="$1"
    ! set_x11 $mode
    set_terminal $mode
    set_system_theme $mode
    set_wm $mode
    echo "$mode" > "$state_file"
}

current_setting() {
    cat "$state_file"
}

toggle() {
    local last="$(! current_setting 2>/dev/null)"
    case "$last" in
        light) echo dark ;;
        dark|*) echo light ;;
    esac
}

switch() {
    case "$1" in
        light|dark) set_theme "$1" ;;
        toggle) set_theme "$(toggle)" ;;
        *) echo "Invalid theme: $1" >&2; exit 1
    esac
}

switch "${1:-toggle}"
