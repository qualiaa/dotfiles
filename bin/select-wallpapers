#!/bin/sh

set -eu

! pkill swaybg

wallpaper_dir="$HOME/.wallpapers/current"
output_dir="$HOME/.wallpapers"
display_dir="$output_dir/displays"

extract-display-info() {
    jq --raw-output '.[] |  [.name , (.rect | if .width > .height then "h" else "v" end)] | join(" ")'
}

# Ensure SWAYSOCK is set
: ${SWAYSOCK:=$(find /run/user/$(id -u) -maxdepth 1 -name "sway-ipc*")}
export SWAYSOCK
[ -n "$SWAYSOCK" ]

mkdir -p "$display_dir"
! rm "$display_dir"/*

swaymsg -t get_outputs | extract-display-info | while read -r name ori; do
    find "$wallpaper_dir/$ori" -mindepth 1 | shuf -n1 | xargs -I{} ln -rs {} "$display_dir/$name"
    swaymsg --quiet output $name background "$display_dir/$name" fill "#996699"
done
